<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CodexSwitch</AssemblyName>
    <RootNamespace>CodexAccountDesk</RootNamespace>
    <Title>Codex Switch</Title>
    <Product>Codex Switch</Product>
    <Version>1.26.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <DebugType>none</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../QueueDiagnostics.cs" Link="Core/QueueDiagnostics.cs" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <Compile Include="../AccountService.cs;../Models.cs;../Storage.cs;../VaultProtection.cs;../MacKeychain.cs;../MacDesktop.cs;../Runtime.cs;../CodexRpc.cs;../OwnedProcessJob.cs;../RefreshCoordinator.cs;../UsageAnalysis.cs;../AccountSwitchCoordinator.cs;../DesktopSwitchBackend.cs;../DesktopShutdown.cs;../DesktopSessionMonitor.cs;../SessionActivity.cs;../DesktopQueueState.cs;../ServerQueueStore.cs;../ReadOnlySqlite.cs;../DriveMonitor.cs;../HardwareUsage.cs;../HardwareHistory.cs;../Localization.cs" Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Burn0Tokens.css" LogicalName="CodexAccountDesk.Burn0Tokens.css" />
    <EmbeddedResource Include="../Burn0Icons.json" LogicalName="CodexAccountDesk.Burn0Icons.json" />
    <EmbeddedResource Include="../Strings.ko.json" LogicalName="CodexAccountDesk.Strings.ko.json" WithCulture="false" />
    <EmbeddedResource Include="../Strings.en.json" LogicalName="CodexAccountDesk.Strings.en.json" WithCulture="false" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
